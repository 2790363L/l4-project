theory M0
begin

builtins: hashing, signing

functions: hpk/1, hseal/3, hopen/3, extract/2, expand/3, mac/2
equations: hopen(sk, info, hseal(hpk(sk), info, m)) = m

restriction Eq:
  "All x y #i. Eq(x, y) @ i ==> x = y"

restriction Neq:
  "All x #i. Neq(x, x) @ i ==> F"

// Setup

// Authentication Service: binds one long-term signature key to X
rule Register_sig:
  [ Fr(~sig) ]
  --[ Register($X, pk(~sig)) ]->
  [ !Ltk($X, ~sig), !Cred($X, pk(~sig)), Out(pk(~sig)) ]

restriction one_key_per_identity:
  "All X pk1 pk2 #i #j.
     Register(X, pk1) @ i & Register(X, pk2) @ j ==> #i = #j"

// B publishes a KeyPackage and keeps the private keys behind it 
rule Publish_KeyPackage:
  let leaf = <$B, hpk(~lk), pk(~sig)>
      kp   = <hpk(~init), leaf>
  in
  [ !Ltk($B, ~sig), Fr(~init), Fr(~lk) ]
  --[ PublishedKP($B, kp) ]->
  [ KeyPkg($B, ~init, ~lk), !InitKey($B, ~init, kp)
  , Out(<kp, sign(<'KeyPackageTBS', kp>, ~sig)>) ] 

// Protocol 

// A creates a one member group at epoch 0. Nothing sent
rule Create_Group:
  [ !Ltk($A, ~sig), Fr(~gid), Fr(~lk), Fr(~es0) ]
  --[ Created($A, ~gid) ]->
  [ Group0($A, ~gid, ~lk, ~es0) ]

/* A commits Add of B with no path and sends the Welcome. 
A takes KeyPackage from the network and checks its signature 
against the AS binding for the identity in its leaf (12.4.1, 12.4.3.1) */
rule Commit_Add:
  let leafA    = <$A, hpk(~lk), pk(~sigA)>              /* A's leaf node */
      leafB    = <$B, lkB, pkB>                         /* B's leaf node */
      kp       = <ik, leafB>                            /* B's KeyPackage */
      GC0      = <~gid, '0', h(leafA), 'empty'>         /* GroupContext, epoch 0 */
      init0    = expand(~es0, 'init', 'empty')          /* init secret, epoch 0 */
      ck0      = expand(~es0, 'confirm', 'empty')       /* confirmation key, epoch 0 */
      tag0     = mac(ck0, 'empty')                      /* confirmation tag, epoch 0 */
      interim0 = h(<'empty', tag0>)                     /* interim transcript hash, epoch 0 */
      content  = <~gid, '0', $A, 'commit', <'add', kp>> /* framed content of the Add commit */
      csig     = sign(<'FramedContentTBS', content, GC0>, ~sigA) /* commit signature (TBS = to be signed) */
      tree1    = <leafA, leafB>                         /* ratchet tree, epoch 1 */
      cth1     = h(<interim0, content, csig>)           /* confirmed transcript hash, epoch 1 */
      GC1      = <~gid, '1', h(tree1), cth1>            /* GroupContext, epoch 1 */
      js       = expand(extract(init0, 'zero'), 'joiner', GC1) /* joiner secret */
      es1      = expand(extract(js, 'zero'), 'epoch', GC1)     /* epoch secret, epoch 1 */
      ck1      = expand(es1, 'confirm', 'empty')        /* confirmation key, epoch 1 */
      tag1     = mac(ck1, cth1)                         /* confirmation tag, epoch 1 */
      gi       = <GC1, tag1>                            /* GroupInfo */
      gisig    = sign(<'GroupInfoTBS', gi>, ~sigA)      /* GroupInfo signature */
      info     = <gi, gisig, tree1>                     /* signed GroupInfo + tree, sent in the Welcome */
      egs      = hseal(ik, <'Welcome', info>, js)       /* encrypted group secrets: js sealed to B's init key */
  in
  [ Group0($A, ~gid, ~lk, ~es0), !Ltk($A, ~sigA) , !Cred($B, pkB), In(<kp, kpsig>) ]
  --[ Eq(verify(kpsig, <'KeyPackageTBS', kp>, pkB), true),
      Neq($A, $B), Committed($A, ~gid, $B, kp, GC1, es1) ]->
  [ Out(<h(<'KeyPackageRef', kp>), egs, info>) ]

/* B joins from a Welcome. Opening egs is done by pattern
   matching on hseal under B's own init key.(12.4.3.1) */
rule Join:
  let leafB = <$B, hpk(~lk), pk(~sigB)>
      kp    = <hpk(~init), leafB>
      leafA = <$A, lkA, pkA>
      tree1 = <leafA, leafB>
      GC1   = <gid, '1', h(tree1), cth1>
      gi    = <GC1, tag1>
      info  = <gi, gisig, tree1>
      egs   = hseal(hpk(~init), <'Welcome', info>, js)
      es1   = expand(extract(js, 'zero'), 'epoch', GC1)
      ck1   = expand(es1, 'confirm', 'empty')
  in
  [ KeyPkg($B, ~init, ~lk), !Ltk($B, ~sigB)
  , !Cred($A, pkA), In(<h(<'KeyPackageRef', kp>), egs, info>) ]
  --[ Eq(verify(gisig, <'GroupInfoTBS', gi>, pkA), true)
    , Eq(tag1, mac(ck1, cth1))
    , Joined($B, gid, $A, kp, GC1, es1) ]->
  [ ]

// Adversary 

rule RevSig:
  [ !Ltk($X, ~sig) ]
  --[ RevSig($X) ]->
  [ Out(~sig) ]

/* Reveals init key behind a KeyPackage. Only possible before B joins
   with it: B deletes the key on joining. */
rule RevInit:
  [ !InitKey($B, ~init, kp) ]
  --[ RevInit($B, kp) ]->
  [ Out(~init) ]

restriction init_key_deleted_on_join:
  "All B gid A kp GC es #i #r.
     Joined(B, gid, A, kp, GC, es) @ i & RevInit(B, kp) @ r ==> r < i"

// Lemmas 

lemma exec: exists-trace
  "Ex A B gid kp GC es #i #j.
       Committed(A, gid, B, kp, GC, es) @ i
     & Joined(B, gid, A, kp, GC, es) @ j
     & not (Ex X #r. RevSig(X) @ r)
     & not (Ex X k #r. RevInit(X, k) @ r)
     & (All X1 X2 g1 g2 #a #b.
          Created(X1, g1) @ a & Created(X2, g2) @ b ==> #a = #b)
     & (All X1 X2 k1 k2 #a #b.
          PublishedKP(X1, k1) @ a & PublishedKP(X2, k2) @ b ==> #a = #b)
     & (All A1 A2 g1 g2 B1 B2 k1 k2 c1 c2 e1 e2 #a #b.
            Committed(A1, g1, B1, k1, c1, e1) @ a
          & Committed(A2, g2, B2, k2, c2, e2) @ b ==> #a = #b)"
  
lemma join_once:
  "All B kp gid1 gid2 A1 A2 GC1 GC2 es1 es2 #i #j.
       Joined(B, gid1, A1, kp, GC1, es1) @ i
     & Joined(B, gid2, A2, kp, GC2, es2) @ j
     ==> #i = #j"

lemma secrecy_committer [reuse]:
  "All A gid B kp GC es #i.
     Committed(A, gid, B, kp, GC, es) @ i
     ==> not (Ex #k. K(es) @ k)
       | (Ex #r. RevSig(B) @ r & r < i)
       | (Ex #r. RevInit(B, kp) @ r)"

lemma agreement_state [reuse]:
  "All B gid A kp GC es #i.
       Joined(B, gid, A, kp, GC, es) @ i
     ==> (Ex B2 kp2 #j. Committed(A, gid, B2, kp2, GC, es) @ j & j < i)
       | (Ex #r. RevSig(A) @ r & r < i)"

lemma secrecy_joiner:
  "All B gid A kp GC es #i.
     Joined(B, gid, A, kp, GC, es) @ i
     ==> not (Ex #k. K(es) @ k)
       | (Ex #r. RevSig(A) @ r & r < i)
       | (Ex #r. RevSig(B) @ r & r < i)
       | (Ex #r. RevInit(B, kp) @ r)"

lemma agreement_keypackage:
  "All B gid A kp GC es #i.
       Joined(B, gid, A, kp, GC, es) @ i
     ==> (Ex #j. Committed(A, gid, B, kp, GC, es) @ j & j < i)
       | (Ex #r. RevSig(A) @ r & r < i)
       | (Ex #r. RevSig(B) @ r & r < i)"

// Attack lemmas 

lemma attack_joiner_secrecy_needs_own_key: exists-trace
  "Ex B gid A kp GC es #i #k.
       Joined(B, gid, A, kp, GC, es) @ i & K(es) @ k
     & not (Ex #r. RevSig(A) @ r)
     & not (Ex X k2 #r. RevInit(X, k2) @ r)
     & (All X1 X2 g1 g2 #a #b.
          Created(X1, g1) @ a & Created(X2, g2) @ b ==> #a = #b)
     & (All X1 X2 k1 k2 #a #b.
          PublishedKP(X1, k1) @ a & PublishedKP(X2, k2) @ b ==> #a = #b)
     & (All A1 A2 g1 g2 B1 B2 k1 k2 c1 c2 e1 e2 #a #b.
            Committed(A1, g1, B1, k1, c1, e1) @ a
          & Committed(A2, g2, B2, k2, c2, e2) @ b ==> #a = #b)"

lemma attack_keypackage_agreement_needs_own_key: exists-trace
  "Ex B gid A kp GC es #i.
       Joined(B, gid, A, kp, GC, es) @ i
     & not (Ex #j. Committed(A, gid, B, kp, GC, es) @ j)
     & not (Ex #r. RevSig(A) @ r)
     & not (Ex X k2 #r. RevInit(X, k2) @ r)
     & (All X1 X2 g1 g2 #a #b.
          Created(X1, g1) @ a & Created(X2, g2) @ b ==> #a = #b)
     & (All X1 X2 k1 k2 #a #b.
          PublishedKP(X1, k1) @ a & PublishedKP(X2, k2) @ b ==> #a = #b)
     & (All A1 A2 g1 g2 B1 B2 k1 k2 c1 c2 e1 e2 #a #b.
            Committed(A1, g1, B1, k1, c1, e1) @ a
          & Committed(A2, g2, B2, k2, c2, e2) @ b ==> #a = #b)"

lemma control_forged_welcome: exists-trace
  "Ex B gid A kp GC es #i.
       Joined(B, gid, A, kp, GC, es) @ i
     & not (Ex A2 g2 B2 k2 c2 e2 #j. Committed(A2, g2, B2, k2, c2, e2) @ j)
     & (All X1 X2 k1 k2 #a #b.
          PublishedKP(X1, k1) @ a & PublishedKP(X2, k2) @ b ==> #a = #b)"

end
