theory M1Remove

configuration: "--stop-on-trace=SEQDFS"

begin

builtins: hashing, signing
functions: hpk/1, hseal/3, hopen/3, extract/2, expand/3, mac/2
equations: hopen(sk, info, hseal(hpk(sk), info, m)) = m

tactic: removal
presort: s
prio:
    regex "!KU\( ~ps"
prio:
    regex "!KU\(.*'path', +'empty'"

restriction Eq:
  "All x y #i. Eq(x, y) @ i ==> x = y"

restriction Neq:
  "All x #i. Neq(x, x) @ i ==> F"

// Setup

rule Register_sig:
  [ Fr(~sig) ]
  --[ Register($X, pk(~sig)) ]->
  [ !Ltk($X, ~sig), !Cred($X, pk(~sig)), Out(pk(~sig)) ]

restriction one_key_per_identity:
  "All X pk1 pk2 #i #j.
     Register(X, pk1) @ i & Register(X, pk2) @ j ==> #i = #j"

rule Publish_KeyPackage:
  let leaf = <$B, hpk(~lk), pk(~sig)>
      kp   = <hpk(~init), leaf>
  in
  [ !Ltk($B, ~sig), Fr(~init), Fr(~lk) ]
  --[ PublishedKP($B, kp) ]->
  [ KeyPkg($B, ~init, ~lk), !InitKey($B, ~init, kp)
  , Out(<kp, sign(<'KeyPackageTBS', kp>, ~sig)>) ]

// Epoch 0 to 1: create, add two members, join

rule Create_Group:
  [ !Ltk($A, ~sig), Fr(~gid), Fr(~lk), Fr(~es0) ]
  --[ Created($A, ~gid) ]->
  [ Group0($A, ~gid, ~lk, ~es0) ]

// A commits two Add proposals with no path and sends one Welcome 
rule Commit_Add:
  let leafA    = <$A, hpk(~lk), pk(~sigA)>
      leafB    = <$B, lkB, pkB>
      leafC    = <$C, lkC, pkC>
      kpB      = <ikB, leafB>
      kpC      = <ikC, leafC>
      GC0      = <~gid, '0', h(leafA), 'empty'>
      init0    = expand(~es0, 'init', 'empty')
      ck0      = expand(~es0, 'confirm', 'empty')
      tag0     = mac(ck0, 'empty')
      interim0 = h(<'empty', tag0>)
      content  = <~gid, '0', $A, 'commit', <<'add', kpB>, <'add', kpC>>>
      csig     = sign(<'FramedContentTBS', content, GC0>, ~sigA)
      tree1    = <leafA, leafB, leafC>
      cth1     = h(<interim0, content, csig>)
      GC1      = <~gid, '1', h(tree1), cth1>
      js       = expand(extract(init0, 'zero'), 'joiner', GC1)
      es1      = expand(extract(js, 'zero'), 'epoch', GC1)
      ck1      = expand(es1, 'confirm', 'empty')
      tag1     = mac(ck1, cth1)
      gi       = <GC1, tag1>
      gisig    = sign(<'GroupInfoTBS', gi>, ~sigA)
      info     = <gi, gisig, tree1>
      egsB     = hseal(ikB, <'Welcome', info>, js)
      egsC     = hseal(ikC, <'Welcome', info>, js)
      interim1 = h(<cth1, tag1>)
      init1    = expand(es1, 'init', 'empty')
      enc1     = expand(es1, 'encryption', 'empty')
  in
  [ Group0($A, ~gid, ~lk, ~es0), !Ltk($A, ~sigA)
  , !Cred($B, pkB), In(<kpB, kpsigB>)
  , !Cred($C, pkC), In(<kpC, kpsigC>) ]
  --[ Eq(verify(kpsigB, <'KeyPackageTBS', kpB>, pkB), true)
    , Eq(verify(kpsigC, <'KeyPackageTBS', kpC>, pkC), true)
    , Neq($A, $B), Neq($A, $C), Neq($B, $C)                        /* 7.3 */
    , Committed($A, ~gid, $B, kpB, $C, kpC, GC1, es1)
    , GroupKey($A, ~gid, '1', enc1) ]->
  [ StA1($A, ~gid, GC1, interim1, init1, ~lk, leafA, leafB, leafC)
  , !Secrets($A, ~gid, '1', init1, enc1, ~lk)
  , Out(< <h(<'KeyPackageRef', kpB>), egsB>
        , <h(<'KeyPackageRef', kpC>), egsC>
        , info >) ]

// The joiner at leaf 1 
rule Join_Leaf1:
  let leafB = <$B, hpk(~lk), pk(~sigB)>
      kp    = <hpk(~init), leafB>
      leafA = <$A, lkA, pkA>
      leafC = <$C, lkC, pkC>
      tree1 = <leafA, leafB, leafC>
      GC1   = <gid, '1', h(tree1), cth1>
      gi    = <GC1, tag1>
      info  = <gi, gisig, tree1>
      egs   = hseal(hpk(~init), <'Welcome', info>, js)
      es1   = expand(extract(js, 'zero'), 'epoch', GC1)
      ck1   = expand(es1, 'confirm', 'empty')
      interim1 = h(<cth1, tag1>)
      init1 = expand(es1, 'init', 'empty')
      enc1  = expand(es1, 'encryption', 'empty')
  in
  [ KeyPkg($B, ~init, ~lk), !Ltk($B, ~sigB)
  , !Cred($A, pkA), !Cred($C, pkC)
  , In(<h(<'KeyPackageRef', kp>), egs, info>) ]
  --[ Eq(verify(gisig, <'GroupInfoTBS', gi>, pkA), true)
    , Eq(tag1, mac(ck1, cth1))
    , Neq($A, $B), Neq($A, $C), Neq($B, $C)
    , Joined($B, gid, $A, kp, GC1, es1)
    , GroupKey($B, gid, '1', enc1) ]->
  [ StB1($B, gid, GC1, interim1, init1, ~lk, leafB, leafA, leafC)
  , !Secrets($B, gid, '1', init1, enc1, ~lk) ]

/* joiner at leaf 2 (R2). It keeps no state fact: never commits or
   processes in this file (R4, R5) */
rule Join_Leaf2:
  let leafC = <$C, hpk(~lk), pk(~sigC)>
      kp    = <hpk(~init), leafC>
      leafA = <$A, lkA, pkA>
      leafB = <$B, lkB, pkB>
      tree1 = <leafA, leafB, leafC>
      GC1   = <gid, '1', h(tree1), cth1>
      gi    = <GC1, tag1>
      info  = <gi, gisig, tree1>
      egs   = hseal(hpk(~init), <'Welcome', info>, js)
      es1   = expand(extract(js, 'zero'), 'epoch', GC1)
      ck1   = expand(es1, 'confirm', 'empty')
      init1 = expand(es1, 'init', 'empty')
      enc1  = expand(es1, 'encryption', 'empty')
  in
  [ KeyPkg($C, ~init, ~lk), !Ltk($C, ~sigC)
  , !Cred($A, pkA), !Cred($B, pkB)
  , In(<h(<'KeyPackageRef', kp>), egs, info>) ]
  --[ Eq(verify(gisig, <'GroupInfoTBS', gi>, pkA), true)
    , Eq(tag1, mac(ck1, cth1))
    , Neq($A, $B), Neq($A, $C), Neq($B, $C)
    , Joined($C, gid, $A, kp, GC1, es1)
    , GroupKey($C, gid, '1', enc1) ]->
  [ !Secrets($C, gid, '1', init1, enc1, ~lk) ]

// Epoch 1 to 2: A removes C, B processes

// A commits a Remove of leaf 2 with a path 
rule Commit_Remove:
  let leafA   = <$A, hpk(~lk), pk(~sigA)>
      leafB   = <$B, lkB, pkB>
      leafC   = <$C, lkC, pkC>
      GC1     = <gid, '1', th1, cth1>
      leafA2  = <$A, hpk(~lk2), pk(~sigA)>
      tree2   = <leafA2, leafB>
      prov    = <gid, '2', h(tree2), cth1>
      ct      = hseal(lkB, <'UpdatePathNode', prov>, ~ps)
      content = <gid, '1', $A, 'commit', <'remove', 'leaf2'>,
                 <'path', leafA2, ct>>
      csig    = sign(<'FramedContentTBS', content, GC1>, ~sigA)
      cth2    = h(<interim1, content, csig>)
      GC2     = <gid, '2', h(tree2), cth2>
      cs      = expand(~ps, 'path', 'empty')
      js2     = expand(extract(init1, cs), 'joiner', GC2)
      es2     = expand(extract(js2, 'zero'), 'epoch', GC2)
      ck2     = expand(es2, 'confirm', 'empty')
      tag2    = mac(ck2, cth2)
      init2   = expand(es2, 'init', 'empty')
      enc2    = expand(es2, 'encryption', 'empty')
  in
  [ StA1($A, gid, GC1, interim1, init1, ~lk, leafA, leafB, leafC)
  , !Ltk($A, ~sigA), Fr(~lk2), Fr(~ps) ]
  --[ Left($A, gid, '1')
    , Removed($A, gid, $C, GC2, es2)
    , SecretInputs($A, gid, init1, ~ps)
    , GroupKey($A, gid, '2', enc2) ]->
  [ !Secrets($A, gid, '2', init2, enc2, ~lk2)
  , Out(<content, csig, tag2>) ]

// B (leaf 1) processes A's Remove commit (12.4.2)
rule Process_Remove:
  let leafB   = <$B, hpk(~lk), pkB>
      leafA   = <$A, lkA, pkA>
      leafC   = <$C, lkC, pkC>
      GC1     = <gid, '1', th1, cth1>
      leafA2  = <$A, lkA2, pkA>
      tree2   = <leafA2, leafB>
      prov    = <gid, '2', h(tree2), cth1>
      ct      = hseal(hpk(~lk), <'UpdatePathNode', prov>, ps)
      content = <gid, '1', $A, 'commit', <'remove', 'leaf2'>,
                 <'path', leafA2, ct>>
      cth2    = h(<interim1, content, csig>)
      GC2     = <gid, '2', h(tree2), cth2>
      cs      = expand(ps, 'path', 'empty')
      js2     = expand(extract(init1, cs), 'joiner', GC2)
      es2     = expand(extract(js2, 'zero'), 'epoch', GC2)
      ck2     = expand(es2, 'confirm', 'empty')
      init2   = expand(es2, 'init', 'empty')
      enc2    = expand(es2, 'encryption', 'empty')
  in
  [ StB1($B, gid, GC1, interim1, init1, ~lk, leafB, leafA, leafC)
  , In(<content, csig, tag2>) ]
  --[ Eq(verify(csig, <'FramedContentTBS', content, GC1>, pkA), true)
    , Eq(tag2, mac(ck2, cth2))
    , Neq(lkA, lkA2)
    , Left($B, gid, '1')
    , Processed($B, gid, $A, $C, GC2, es2)
    , GroupKey($B, gid, '2', enc2) ]->
  [ !Secrets($B, gid, '2', init2, enc2, ~lk) ]

// Adversary

rule RevSig:
  [ !Ltk($X, ~sig) ]
  --[ RevSig($X) ]->
  [ Out(~sig) ]

rule RevInit:
  [ !InitKey($B, ~init, kp) ]
  --[ RevInit($B, kp) ]->
  [ Out(~init) ]

rule RevState:
  [ !Secrets($X, gid, ep, init, enc, lk) ]
  --[ RevState($X, gid, ep) ]->
  [ Out(<init, enc, lk>) ]

restriction state_deleted_on_leaving:
  "All X gid ep #r #t.
     RevState(X, gid, ep) @ r & Left(X, gid, ep) @ t ==> r < t"

restriction init_key_deleted_on_join:
  "All B gid A kp GC es #i #r.
     Joined(B, gid, A, kp, GC, es) @ i & RevInit(B, kp) @ r ==> r < i"

// Lemmas

// honest run checked in two parts, to keep each trace short

/* checks model can create initial group and have both new 
members join without any compromise */
lemma exec_join_both: exists-trace
  "Ex A B C gid kpB kpC GC1 es1 #i #jb #jc.
       Committed(A, gid, B, kpB, C, kpC, GC1, es1) @ i
     & Joined(B, gid, A, kpB, GC1, es1) @ jb
     & Joined(C, gid, A, kpC, GC1, es1) @ jc
     & not (Ex X #r. RevSig(X) @ r)
     & not (Ex X k #r. RevInit(X, k) @ r)
     & not (Ex X g e #r. RevState(X, g, e) @ r)
     /* one of each step, to keep the search small */
     & (All X1 X2 g1 g2 #a #b.
          Created(X1, g1) @ a & Created(X2, g2) @ b ==> #a = #b)
     & (All X k1 k2 #a #b.
          PublishedKP(X, k1) @ a & PublishedKP(X, k2) @ b ==> #a = #b)
     & (All A1 A2 g1 g2 B1 B2 C1 C2 k1 k2 k3 k4 c1 c2 e1 e2 #a #b.
            Committed(A1, g1, B1, k1, C1, k3, c1, e1) @ a
          & Committed(A2, g2, B2, k2, C2, k4, c2, e2) @ b ==> #a = #b)"

/* runs through complete remove flow: B joins, A removes C, and B
processes resulting commit without compromise */
lemma exec_remove: exists-trace
  "Ex A B C gid kpB kpC GC1 es1 GC2 es2 #i #jb #u #p.
       Committed(A, gid, B, kpB, C, kpC, GC1, es1) @ i
     & Joined(B, gid, A, kpB, GC1, es1) @ jb
     & Removed(A, gid, C, GC2, es2) @ u
     & Processed(B, gid, A, C, GC2, es2) @ p
     & not (Ex X #r. RevSig(X) @ r)
     & not (Ex X k #r. RevInit(X, k) @ r)
     & not (Ex X g e #r. RevState(X, g, e) @ r)
     /* one of each step, to keep the search small */
     & (All X1 X2 g1 g2 #a #b.
          Created(X1, g1) @ a & Created(X2, g2) @ b ==> #a = #b)
     & (All X k1 k2 #a #b.
          PublishedKP(X, k1) @ a & PublishedKP(X, k2) @ b ==> #a = #b)
     & (All A1 A2 g1 g2 B1 B2 C1 C2 k1 k2 k3 k4 c1 c2 e1 e2 #a #b.
            Committed(A1, g1, B1, k1, C1, k3, c1, e1) @ a
          & Committed(A2, g2, B2, k2, C2, k4, c2, e2) @ b ==> #a = #b)
     & (All X1 X2 g1 g2 Y1 Y2 c1 c2 e1 e2 #a #b.
            Removed(X1, g1, Y1, c1, e1) @ a
          & Removed(X2, g2, Y2, c2, e2) @ b ==> #a = #b)"

/* says that the first epoch's secret stays private unless one of the new
members was already compromised through its signing key or init key */
lemma secrecy_epoch1 [reuse]:
  "All A gid B kpB C kpC GC es #i.
     Committed(A, gid, B, kpB, C, kpC, GC, es) @ i
     ==> not (Ex #k. K(es) @ k)
       | (Ex #r. RevSig(B) @ r & r < i)
       | (Ex #r. RevSig(C) @ r & r < i)
       | (Ex #r. RevInit(B, kpB) @ r)
       | (Ex #r. RevInit(C, kpC) @ r)"

/* makes sure every joined state comes from A's earlier commit, tying the
later security reasoning to an authentic group history */
lemma agreement_join [reuse]:
  "All X gid A kp GC es #i.
       Joined(X, gid, A, kp, GC, es) @ i
     ==> (Ex B kpB C kpC #j.
            Committed(A, gid, B, kpB, C, kpC, GC, es) @ j & j < i)
       | (Ex #r. RevSig(A) @ r & r < i)"

/* makes sure B only processes a remove commit made by A, so both sides 
agree on the new epoch and its secret */
lemma agreement_remove [reuse]:
  "All B gid A C GC es #i.
       Processed(B, gid, A, C, GC, es) @ i
     ==> (Ex #j. Removed(A, gid, C, GC, es) @ j & j < i)
       | (Ex #r. RevSig(A) @ r & r < i)"

/* A's fresh path secret stays secret, and shows the two ways B's
prior compromise could reveal it */
lemma path_secret_secrecy [reuse]:
  "All A gid B kpB C kpC GC1 es1 i1 ps #i #u.
       Committed(A, gid, B, kpB, C, kpC, GC1, es1) @ i
     & SecretInputs(A, gid, i1, ps) @ u
     ==> not (Ex #j. KU(ps) @ j)
       | (Ex g A2 GCj esj e #j #r.
            Joined(B, g, A2, kpB, GCj, esj) @ j & RevState(B, g, e) @ r)
       | (Ex #r. RevSig(B) @ r & r < i)"

/* main security claim: after removing C, A's epoch 2 key stays
private even when attacker knows C's state and other allowed secrets */
lemma removal_security [heuristic={removal}, hide_lemma=secrecy_epoch1]:
  "All A gid B kpB C kpC GC1 es1 GC es k #i #u.
       Committed(A, gid, B, kpB, C, kpC, GC1, es1) @ i
     & Removed(A, gid, C, GC, es) @ u
     & GroupKey(A, gid, '2', k) @ u
        ==> not (Ex #j. K(k) @ j)
       | (Ex #r. RevState(A, gid, '2') @ r)
       | (Ex A2 GCj esj #j #r.
            Joined(B, gid, A2, kpB, GCj, esj) @ j & RevState(B, gid, '2') @ r)
       | (Ex A2 GCj esj #j #r.
            Joined(B, gid, A2, kpB, GCj, esj) @ j & RevState(B, gid, '1') @ r)
       | (Ex g A2 GCj esj e #j #r.
            Joined(B, g, A2, kpB, GCj, esj) @ j & RevState(B, g, e) @ r
          & not (g = gid))
       | (Ex #r. RevSig(B) @ r & r < i)"

/* This shows baseline: C can still recover old group key from its retained 
epoch-1 state, so it is remove that keeps C out of epoch 2 */
lemma control_removed_member_had_key: exists-trace
  "Ex X A C gid GC es k #i #j #r #u.
       GroupKey(X, gid, '1', k) @ i & K(k) @ j
     & Removed(A, gid, C, GC, es) @ u
     & RevState(C, gid, '1') @ r
     & (All Y1 Y2 g1 g2 e1 e2 #a #b.
          RevState(Y1, g1, e1) @ a & RevState(Y2, g2, e2) @ b ==> #a = #b)
     & not (Ex Z #s. RevSig(Z) @ s)
     & not (Ex Z k2 #s. RevInit(Z, k2) @ s)
     & (All X1 X2 g1 g2 #a #b.
          Created(X1, g1) @ a & Created(X2, g2) @ b ==> #a = #b)
     & (All Z k1 k2 #a #b.
          PublishedKP(Z, k1) @ a & PublishedKP(Z, k2) @ b ==> #a = #b)
     & (All A1 A2 g1 g2 B1 B2 C1 C2 k1 k2 k3 k4 c1 c2 e1 e2 #a #b.
            Committed(A1, g1, B1, k1, C1, k3, c1, e1) @ a
          & Committed(A2, g2, B2, k2, C2, k4, c2, e2) @ b ==> #a = #b)"

/* to show that removing C cannot repair group if B's epoch 1 state was
compromised before the remove */
lemma attack_remaining_member_compromised: exists-trace
  "Ex A B C gid GC es i1 ps k #u #p #r #x #y #z.
       Removed(A, gid, C, GC, es) @ u
     & SecretInputs(A, gid, i1, ps) @ u
     & GroupKey(A, gid, '2', k) @ u
     & Processed(B, gid, A, C, GC, es) @ p
     & RevState(B, gid, '1') @ r & r < u
     & K(i1) @ x & K(ps) @ y & K(k) @ z
     & (All Y1 Y2 g1 g2 e1 e2 #a #b.
          RevState(Y1, g1, e1) @ a & RevState(Y2, g2, e2) @ b ==> #a = #b)
     & not (Ex Z #s. RevSig(Z) @ s)
     & not (Ex Z k2 #s. RevInit(Z, k2) @ s)
     & (All X1 X2 g1 g2 #a #b.
          Created(X1, g1) @ a & Created(X2, g2) @ b ==> #a = #b)
     & (All Z k1 k2 #a #b.
          PublishedKP(Z, k1) @ a & PublishedKP(Z, k2) @ b ==> #a = #b)
     & (All A1 A2 g1 g2 B1 B2 C1 C2 k1 k2 k3 k4 c1 c2 e1 e2 #a #b.
            Committed(A1, g1, B1, k1, C1, k3, c1, e1) @ a
          & Committed(A2, g2, B2, k2, C2, k4, c2, e2) @ b ==> #a = #b)
     & (All X1 X2 g1 g2 Y1 Y2 c1 c2 e1 e2 #a #b.
            Removed(X1, g1, Y1, c1, e1) @ a
          & Removed(X2, g2, Y2, c2, e2) @ b ==> #a = #b)"

/* to show why reusing B's KeyPackage across groups is dangerous: a 
compromise in another group can reveal the path secret here */
lemma attack_keypackage_reused_in_another_group: exists-trace
  "Ex A B C gid kpB kpC GC1 es1 A2 g2 C2 kpC2 GCb esb i1 ps
      #i #i2 #j #jc #u #r #rc #x #y #z.
       Committed(A, gid, B, kpB, C, kpC, GC1, es1) @ i
     & Committed(A2, g2, B, kpB, C2, kpC2, GCb, esb) @ i2
     & not (g2 = gid)
     & Joined(B, g2, A2, kpB, GCb, esb) @ j
     & Joined(C, gid, A, kpC, GC1, es1) @ jc
     & SecretInputs(A, gid, i1, ps) @ u
     & GroupKey(A, gid, '2', k) @ u
     & RevState(B, g2, '1') @ r
     & RevState(C, gid, '1') @ rc
     & K(i1) @ x & K(ps) @ y & K(k) @ z
     & (All Y g e #a. RevState(Y, g, e) @ a ==> (#a = #r) | (#a = #rc))
     & not (Ex Z #s. RevSig(Z) @ s)
     & not (Ex Z k2 #s. RevInit(Z, k2) @ s)
     /* two groups, one of each other step, to keep the search small */
     & (All X g #a. Created(X, g) @ a ==> (g = gid) | (g = g2))
     & (All Z k1 k2 #a #b.
          PublishedKP(Z, k1) @ a & PublishedKP(Z, k2) @ b ==> #a = #b)
     & (All A1 g1 B1 k1 C1 k3 c1 e1 #a.
          Committed(A1, g1, B1, k1, C1, k3, c1, e1) @ a
          ==> (#a = #i) | (#a = #i2))
     & (All X1 X2 g1 g3 Y1 Y2 c1 c2 e1 e2 #a #b.
            Removed(X1, g1, Y1, c1, e1) @ a
          & Removed(X2, g3, Y2, c2, e2) @ b ==> #a = #b)"

end
